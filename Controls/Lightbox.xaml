<UserControl x:Class="AppCenter.Controls.Lightbox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed"
             Focusable="True"
             IsTabStop="False"
             AutomationProperties.Name="Screenshot viewer">

    <!--  Everything in here sits over the whole window. The scrim is the
          bottom layer and is what a click lands on when it is not on the
          picture or a button: that is what "outside" means.

          The theme is reached through DynamicResource throughout, where the
          rest of the app says Static: this control is built by its tests
          with no application and no theme loaded, and a Static lookup that
          finds nothing is an exception where a Dynamic one is an unstyled
          button. In the app the two resolve to the same thing.  -->
    <Grid>
        <Border x:Name="Scrim"
                Background="#D9000000"
                MouseLeftButtonDown="OnScrimClicked" />

        <!--  Room for the arrows at the sides and the caption below. No
              background, so a click in the margin falls through to the scrim.  -->
        <Grid x:Name="Area" Margin="96,56,96,72">
            <Border x:Name="Frame"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FF0A0A0A"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    MouseLeftButtonDown="OnPictureClicked">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.7" Color="Black" />
                </Border.Effect>
                <Grid>
                    <!--  Uniform inside a centred parent has no size to fit, so
                          the area's size is handed over as a ceiling; the
                          picture then scales down to fit and the frame hugs it.  -->
                    <Image x:Name="Picture"
                           Stretch="Uniform"
                           StretchDirection="Both"
                           MaxWidth="{Binding ActualWidth, ElementName=Area}"
                           MaxHeight="{Binding ActualHeight, ElementName=Area}"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <!--  On the picture's own corner, not the window's. In the
                          window's corner it sat exactly over App Center's close
                          button - a second click there, or one a moment late,
                          and the app is gone instead of the picture.  -->
                    <Button x:Name="CloseButton"
                            Style="{DynamicResource LightboxButton}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,12,12,0"
                            Tag="{DynamicResource IconClose}"
                            ToolTip="Close (Escape)"
                            AutomationProperties.Name="Close screenshot viewer"
                            Click="OnCloseClicked" />
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="Caption"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,30"
                   FontSize="13"
                   Foreground="#B3FFFFFF" />

        <Button x:Name="PrevButton"
                Style="{DynamicResource LightboxButton}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="24,0,0,0"
                Tag="{DynamicResource IconChevronLeft}"
                ToolTip="Previous (Left arrow)"
                AutomationProperties.Name="Previous screenshot"
                Click="OnPrevClicked" />

        <Button x:Name="NextButton"
                Style="{DynamicResource LightboxButton}"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,24,0"
                Tag="{DynamicResource IconChevronRight}"
                ToolTip="Next (Right arrow)"
                AutomationProperties.Name="Next screenshot"
                Click="OnNextClicked" />
    </Grid>
</UserControl>
