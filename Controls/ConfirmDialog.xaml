<Window x:Class="AppCenter.Controls.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Ideal">

    <Border Background="{DynamicResource DialogBgBrush}"
            BorderBrush="{DynamicResource ButtonBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="26,22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="5" Opacity="0.55" Color="Black" />
        </Border.Effect>

        <StackPanel>
            <TextBlock x:Name="TitleText"
                       FontFamily="{StaticResource DisplayFont}"
                       FontSize="18"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextWrapping="Wrap" />

            <TextBlock x:Name="MessageText"
                       Margin="0,12,0,0"
                       FontSize="13.5"
                       LineHeight="20"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,24,0,0">
                <Button x:Name="CancelButton"
                        Style="{StaticResource PillButton}"
                        Content="Cancel"
                        IsCancel="True"
                        Click="OnCancel" />
                <Button x:Name="ConfirmButton"
                        Style="{StaticResource GreenButton}"
                        Margin="10,0,0,0"
                        IsDefault="True"
                        Click="OnConfirm" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
