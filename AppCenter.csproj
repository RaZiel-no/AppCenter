<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AppCenter</RootNamespace>
    <AssemblyName>AppCenter</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>AppCenter.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!--  Program.Main, ahead of the one the XAML compiler writes for App.xaml,
          so the warm-up can start before the Application is built.  -->
    <StartupObject>AppCenter.Program</StartupObject>
    <!--  For the Store interop in StoreListingService: the generated COM
          wrappers, and one method that writes HSTRINGs into a caller's array.  -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--  Launch time. WPF itself cannot be compiled ahead of time, but the
        app's own code can - ReadyToRun puts native code in the published
        assembly, so what runs at launch is not compiled at launch. NLS is
        Windows' own globalisation: the ICU library is otherwise loaded and a
        collator built for the user's locale before the first window can be
        created, and this is Windows, which has all of that in the kernel.
        Sorting and dates stay locale-aware; they come from Windows instead.  -->
  <PropertyGroup>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Globalization.UseNls" Value="true" />
  </ItemGroup>

  <!--  Shipping metadata. <Version> is the last version that was released:
        deploy.bat reads it, ships the next patch, and writes that number back
        here when the release is built. It is the one place it is recorded, and
        the About page shows whatever the running build was stamped with.  -->
  <PropertyGroup>
    <Version>1.0.8</Version>
    <Product>App Center</Product>
    <AssemblyTitle>App Center</AssemblyTitle>
    <Description>Ubuntu's App Center, rebuilt for Windows on top of winget.</Description>
    <!--  Plain ASCII on purpose: these feed the installer, the Add/Remove entry
          and the winget manifest. The About page shows the real spelling.  -->
    <Company>Arnstein Skara</Company>
    <Authors>Arnstein Skara</Authors>
    <Copyright>Copyright © 2026 Arnstein Skara</Copyright>
  </PropertyGroup>

  <!--  The project sits at the root of the repository and takes everything
        below it, so the test project - which lives under it - has to be told
        apart by hand. Without this its files are compiled into the app as well,
        and the app goes looking for xunit.  -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <Page Remove="tests\**" />
    <Resource Remove="tests\**" />
    <Content Remove="tests\**" />
  </ItemGroup>

  <!--  The tests reach the parser, the operation's own transitions and the
        batch loop directly. All three are internal because nothing outside the
        assembly has business calling them - which is still true of the tests,
        except that they are the assembly's account of what it promises.  -->
  <ItemGroup>
    <InternalsVisibleTo Include="AppCenter.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="catalog.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!--  GPL section 4: the licence travels with the binary, so it ships in the
          installer and the portable zip, and About links to this copy.  -->
    <Content Include="LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!--  SharpVectors is BSD-3-Clause, which asks that its notice travel with
          any binary that carries it. Same journey as LICENSE.  -->
    <Content Include="THIRD-PARTY-NOTICES.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!--  ApplicationIcon covers the exe; Window.Icon needs it in the assembly too  -->
    <Resource Include="AppCenter.ico" />
  </ItemGroup>

  <!--  The one package. WPF decodes ico, png and jpg and nothing else, and
        the favicon a modern site declares is as likely to be an SVG; this
        draws those. Managed code only, BSD-3-Clause, and loaded on the first
        SVG met rather than at launch - see IconService.RasterizeSvg.  -->
  <ItemGroup>
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.6" />
  </ItemGroup>

</Project>
