<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:services="clr-namespace:AppCenter.Services">

    <!--  ============================================================
          Publisher badges
          A filled circle with a glyph on top - the green tick for
          verified publishers, the orange star for community ones.
          ============================================================  -->

    <Style x:Key="BadgeGlyph" TargetType="Path">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Stroke" Value="White" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
    </Style>

    <!--  ============================================================
          App card - the 2-up grid tile used by Explore, the category
          pages and search results.
          ============================================================  -->

    <Style x:Key="AppCardButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Height" Value="152" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Card"
                            Background="{DynamicResource CardBgBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="20,18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  Icon + name + publisher  -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--  Where this app stands on the machine, painted on
                                      by MachineState: a tick for installed, and the
                                      accent when an update is waiting. Nothing at all
                                      for the rest, which is most cards - a badge on
                                      every card says nothing on any of them.  -->
                                <Border x:Name="StateChip"
                                        Grid.Column="2"
                                        Visibility="Collapsed"
                                        VerticalAlignment="Top"
                                        Margin="10,0,0,0"
                                        Padding="8,2,9,2"
                                        CornerRadius="10"
                                        Background="{DynamicResource ButtonBgBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="11" Height="11" VerticalAlignment="Center">
                                            <Path x:Name="StateGlyph"
                                                  Style="{StaticResource BadgeGlyph}"
                                                  Data="{StaticResource GlyphCheck}"
                                                  Stroke="{DynamicResource GreenBrush}"
                                                  StrokeThickness="2.5" />
                                        </Viewbox>
                                        <TextBlock x:Name="StateLabel"
                                                   Margin="5,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="Installed" />
                                    </StackPanel>
                                </Border>

                                <Border x:Name="IconTile"
                                        Grid.Column="0"
                                        Width="56"
                                        Height="56"
                                        CornerRadius="12"
                                        Background="{Binding FallbackBrush}">
                                    <Grid>
                                        <TextBlock x:Name="IconInitial"
                                                   Text="{Binding Initial}"
                                                   FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="26"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <Image Source="{Binding Icon}"
                                               Width="48"
                                               Height="48"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="16,3,0,0" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Name}"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="15"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />

                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Publisher}"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />

                                        <Grid x:Name="BadgeVerified"
                                              Width="14"
                                              Height="14"
                                              Margin="6,1,0,0"
                                              VerticalAlignment="Center"
                                              Visibility="Collapsed">
                                            <Ellipse Fill="{DynamicResource GreenBrush}" />
                                            <Viewbox Width="9" Height="9">
                                                <Path Style="{StaticResource BadgeGlyph}" Data="{StaticResource GlyphCheck}" />
                                            </Viewbox>
                                        </Grid>

                                        <Grid x:Name="BadgeStar"
                                              Width="14"
                                              Height="14"
                                              Margin="6,1,0,0"
                                              VerticalAlignment="Center"
                                              Visibility="Collapsed">
                                            <Ellipse Fill="{DynamicResource AccentBrush}" />
                                            <Viewbox Width="9" Height="9">
                                                <Path Style="{StaticResource BadgeGlyph}"
                                                      Data="{StaticResource GlyphStarSolid}"
                                                      Fill="White"
                                                      StrokeThickness="0" />
                                            </Viewbox>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!--  Summary  -->
                            <TextBlock Grid.Row="1"
                                       Margin="0,20,0,0"
                                       VerticalAlignment="Top"
                                       Text="{Binding Summary}"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="13.5"
                                       LineHeight="19"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardHoverBgBrush}" />
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource CardHoverBorderBrush}" />
                        </Trigger>

                        <!--  A real icon replaces the coloured initial tile  -->
                        <DataTrigger Binding="{Binding HasIcon}" Value="True">
                            <Setter TargetName="IconInitial" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IconTile" Property="Background" Value="Transparent" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding Badge}" Value="Verified">
                            <Setter TargetName="BadgeVerified" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Badge}" Value="Star">
                            <Setter TargetName="BadgeStar" Property="Visibility" Value="Visible" />
                        </DataTrigger>

                        <!--  Update is listed after Installed so it wins: an
                              app with an update waiting is installed too.  -->
                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                            <Setter TargetName="StateChip" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                            <Setter TargetName="StateChip" Property="Visibility" Value="Visible" />
                            <Setter TargetName="StateGlyph" Property="Data" Value="{StaticResource GlyphArrowUp}" />
                            <Setter TargetName="StateGlyph" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="StateLabel" Property="Text" Value="Update" />
                            <Setter TargetName="StateLabel" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="AppCardTemplate">
        <!--  The card has no textual Content, so it needs an explicit
              accessible name for screen readers.  -->
        <Button Style="{StaticResource AppCardButton}"
                Margin="9"
                AutomationProperties.Name="{Binding Name}"
                AutomationProperties.HelpText="{Binding Summary}" />
    </DataTemplate>

    <!--  ============================================================
          Banner highlight tile - the small logos on the Explore banner.
          Each one opens the detail page for its app, so it is a button
          rather than a plain tile.
          ============================================================  -->

    <Style x:Key="BannerTileButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <!--  64px tile plus the 4px the hover ring needs on every side  -->
        <Setter Property="Width" Value="72" />
        <Setter Property="Height" Value="72" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!--  The ring is drawn outside the tile and is invisible
                          until hovered, so pointing at a logo never moves it.  -->
                    <Border x:Name="Ring"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="2"
                            CornerRadius="18"
                            Padding="2">
                        <Border x:Name="Tile" CornerRadius="14" Background="White">
                            <Grid>
                                <TextBlock x:Name="Initial"
                                           Text="{Binding Initial}"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontSize="28"
                                           Foreground="#FF303030"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <Image Source="{Binding Icon}"
                                       Width="44"
                                       Height="44"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </Border>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="#66FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="#A6FFFFFF" />
                            <Setter TargetName="Tile" Property="Background" Value="#FFE8E8E8" />
                        </Trigger>

                        <!--  A real icon replaces the initial  -->
                        <DataTrigger Binding="{Binding HasIcon}" Value="True">
                            <Setter TargetName="Initial" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="BannerTileTemplate">
        <!--  Logo only, so the app name has to come from the tooltip and
              the automation name.  -->
        <Button Style="{StaticResource BannerTileButton}"
                Margin="6,0"
                ToolTip="{Binding Name}"
                AutomationProperties.Name="{Binding Name}" />
    </DataTemplate>

    <!--  ============================================================
          Theme swatch - one tile per theme in About > Appearance.
          The preview draws a miniature of the app in that theme's own
          colours, so all four read at a glance without switching.
          ============================================================  -->

    <Style x:Key="ThemeSwatchButton" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="GroupName" Value="Theme" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Margin="0,0,14,0">
                        <Border x:Name="Frame"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                CornerRadius="11"
                                Padding="3">
                            <Border Height="96"
                                    CornerRadius="7"
                                    Background="{Binding ContentBrush}"
                                    BorderBrush="{Binding CardBorderBrush}"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Sidebar, with three nav rows  -->
                                    <Border Grid.Column="0"
                                            Background="{Binding SidebarBrush}"
                                            CornerRadius="6,0,0,6">
                                        <StackPanel VerticalAlignment="Center" Margin="6,0">
                                            <Rectangle Height="4" RadiusX="2" RadiusY="2"
                                                       Fill="{Binding TextPrimaryBrush}" Opacity="0.85" />
                                            <Rectangle Height="4" RadiusX="2" RadiusY="2" Margin="0,5,0,0"
                                                       Fill="{Binding TextSecondaryBrush}" />
                                            <Rectangle Height="4" RadiusX="2" RadiusY="2" Margin="0,5,4,0"
                                                       Fill="{Binding TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <!--  A card, the way the grid draws one  -->
                                    <Border Grid.Column="1"
                                            Margin="9,12,11,12"
                                            CornerRadius="6"
                                            Padding="8,7"
                                            Background="{Binding CardBrush}"
                                            BorderBrush="{Binding CardBorderBrush}"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Width="20"
                                                    Height="20"
                                                    CornerRadius="6"
                                                    VerticalAlignment="Top"
                                                    Background="{Binding AccentBrush}" />

                                            <StackPanel Grid.Column="1" Margin="8,2,0,0">
                                                <Rectangle Height="4" RadiusX="2" RadiusY="2"
                                                           Fill="{Binding TextPrimaryBrush}" />
                                                <Rectangle Height="4" RadiusX="2" RadiusY="2" Margin="0,6,12,0"
                                                           Fill="{Binding TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Border>

                        <TextBlock x:Name="Label"
                                   Margin="6,8,0,0"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding Name}" />
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <!--  Checked is listed last so it still wins while hovered  -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource CardHoverBorderBrush}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="ThemeSwatchTemplate">
        <RadioButton Style="{StaticResource ThemeSwatchButton}"
                     IsChecked="{Binding IsSelected, Mode=OneWay}"
                     ToolTip="{Binding Blurb}"
                     AutomationProperties.Name="{Binding Name}"
                     AutomationProperties.HelpText="{Binding Blurb}" />
    </DataTemplate>

    <!--  ============================================================
          Category tile - one entry in the picker pinned at the foot of Explore
          ============================================================  -->

    <Style x:Key="CategoryTileButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Tile"
                            Background="Transparent"
                            CornerRadius="6"
                            Padding="7,8">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Tile" Property="Background" Value="{DynamicResource RowHoverBgBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="CategoryTileTemplate">
        <!--  The content is a panel, so the button has no text of its own to be
              named by: screen readers and automation get the name from here.  -->
        <Button Style="{StaticResource CategoryTileButton}"
                AutomationProperties.Name="{Binding Name}">
            <StackPanel Orientation="Horizontal">
                <Viewbox Width="17" Height="17" VerticalAlignment="Center">
                    <!--  The glyph is named by the catalogue, so IconKey looks
                          it up rather than the template hard-coding one.  -->
                    <Path Style="{StaticResource Icon}"
                          Data="{Binding Icon, Converter={StaticResource IconKey}}"
                          Stroke="{DynamicResource TextSecondaryBrush}" />
                </Viewbox>
                <TextBlock Text="{Binding Name}"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Button>
    </DataTemplate>

    <!--  ============================================================
          Small icon tile reused by the Manage rows and detail header
          ============================================================  -->

    <Style x:Key="RowIconTile" TargetType="Border">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Background" Value="{Binding FallbackBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasIcon}" Value="True">
                <Setter Property="Background" Value="Transparent" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  ============================================================
          Manage - "Updates available" row
          ============================================================  -->

    <DataTemplate x:Key="UpdateRowTemplate">
        <!--  The row opens the package's page: it is a button tagged "row",
              and ManageView.OnRowButtonClick tells it from the Update button
              inside it by the tag.  -->
        <Button x:Name="Row"
                Style="{StaticResource RowButton}"
                Tag="row"
                AutomationProperties.Name="{Binding Name}"
                AutomationProperties.HelpText="{Binding VersionTransition}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!--  Everything below defaults to row 0; row 1 is the bar, and
                      row 2 the reason an update was passed over.  -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Column="0" Style="{StaticResource RowIconTile}">
                    <Grid>
                        <TextBlock x:Name="Initial"
                                   Text="{Binding Initial}"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="18"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <Image Source="{Binding Icon}"
                               Width="32"
                               Height="32"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="14"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,2,0,0"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding VersionTransition}" />

                    <!--  The one row whose update takes the window with it: the
                          runtime this app is running on, or the app itself.
                          Said here, under the versions, because this is where
                          the row is read before its button is pressed - the
                          dialog says it again at length. Accent rather than
                          error: nothing has gone wrong, and a red line on a
                          package that is working perfectly reads as one that
                          is not. Collapsed for every other row, which is
                          nearly all of them.  -->
                    <TextBlock x:Name="ClosesAppNote"
                               Margin="0,3,0,0"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Foreground="{DynamicResource AccentBrush}"
                               Text="{x:Static services:SelfPackages.RowNote}" />
                </StackPanel>

                <!--  Why "update all" left this one behind, in winget's own
                      words. Indented to the name it belongs to, wrapped rather
                      than trimmed - a reason nobody can finish reading is no
                      better than no reason - and gone entirely when empty.  -->
                <StackPanel Grid.Row="2"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Margin="14,8,0,0"
                            Visibility="{Binding Error, Converter={StaticResource EmptyToCollapsed}}">
                    <TextBlock FontFamily="{StaticResource AppFont}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ErrorBrush}"
                               Text="{Binding Error}" />

                    <!--  Under the reason it answers, and only when the reason
                          is a want of administrator rights. The shield is
                          Windows' own mark for a button that asks for them.  -->
                    <Button x:Name="AdminButton"
                            Style="{StaticResource PillButton}"
                            Tag="update-admin"
                            Visibility="Collapsed"
                            HorizontalAlignment="Left"
                            Margin="0,8,0,0"
                            Height="30"
                            Padding="12,0"
                            FontSize="12.5"
                            AutomationProperties.Name="Retry as administrator">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15" Height="15">
                                <Path Style="{StaticResource Icon}"
                                      Data="{StaticResource IconShield}"
                                      Stroke="{DynamicResource TextPrimaryBrush}" />
                            </Viewbox>
                            <TextBlock Text="Retry as administrator" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!--  The status sits beside the button rather than over it: a
                      row can be idle and still have something to say, like an
                      update that needs the app restarted before it takes.  -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="12.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding Status}"
                               Visibility="{Binding Status, Converter={StaticResource EmptyToCollapsed}}" />
                    <Button x:Name="UpdateButton"
                            Style="{StaticResource PillButton}"
                            Tag="update"
                            Height="32"
                            Padding="16,0"
                            Content="Update" />
                </StackPanel>

                <!--  Spans the row rather than sitting in the status column:
                      the update belongs to the whole row, and a 3px line under
                      it reads as progress without shouting.  -->
                <ProgressBar Grid.Row="1"
                             Grid.ColumnSpan="3"
                             Margin="0,10,0,0"
                             Style="{StaticResource OperationProgressBar}" />
            </Grid>
        </Button>

        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasIcon}" Value="True">
                <Setter TargetName="Initial" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CanRetryAsAdmin}" Value="True">
                <Setter TargetName="AdminButton" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <!--  After the one above, so a busy row hides both buttons.  -->
            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                <Setter TargetName="UpdateButton" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="AdminButton" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ClosesApp}" Value="True">
                <Setter TargetName="ClosesAppNote" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <!--  The first row needs no separator above it  -->
            <DataTrigger Value="0"
                         Binding="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}">
                <Setter TargetName="Row" Property="BorderThickness" Value="0" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--  ============================================================
          Manage - "Installed apps" rows

          The list is one InstalledGroup per row. Most hold a single
          package and look like any list row; one holding a family - the
          Visual C++ redistributables, every .NET SDK - shows the family's
          name, how many installs it covers, and a chevron, and opens to
          list the installs underneath, each with its own Uninstall.
          ============================================================  -->

    <!--  One install inside an opened family. Indented past the family's
          icon, named by what it adds to the family - "2010 x64
          Redistributable", or its version - and otherwise the same row as
          a package on its own: clickable, with a button, a bar and a
          reason of its own.  -->
    <DataTemplate x:Key="InstalledVersionTemplate">
        <Button x:Name="Row"
                Style="{StaticResource RowButton}"
                Tag="row"
                Padding="16,8,16,9"
                AutomationProperties.Name="{Binding NameAndVersion}"
                AutomationProperties.HelpText="{Binding VariantLabel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="RowAction" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  A tick of the border colour, so the indent reads as
                      "part of the row above" rather than as a gap.  -->
                <Rectangle Grid.Column="0"
                           Width="2"
                           RadiusX="1"
                           RadiusY="1"
                           Margin="18,2,0,2"
                           HorizontalAlignment="Left"
                           Fill="{DynamicResource CardBorderBrush}" />

                <StackPanel Grid.Column="1" Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding VariantLabel}"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="13.5"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,2,0,0"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding VariantDetail}"
                               Visibility="{Binding VariantDetail, Converter={StaticResource EmptyToCollapsed}}" />
                </StackPanel>

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Margin="0,0,14,0"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding VariantId}" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="12.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding Status}"
                               Visibility="{Binding Status, Converter={StaticResource EmptyToCollapsed}}" />
                    <Button x:Name="UninstallButton"
                            Style="{StaticResource PillButton}"
                            Tag="uninstall"
                            Height="30"
                            Padding="14,0"
                            FontSize="13"
                            Content="Uninstall" />
                </StackPanel>

                <ProgressBar Grid.Row="1"
                             Grid.Column="1"
                             Grid.ColumnSpan="3"
                             Margin="0,9,0,0"
                             Style="{StaticResource OperationProgressBar}" />

                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           Grid.ColumnSpan="3"
                           Margin="0,8,0,0"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource ErrorBrush}"
                           Text="{Binding Error}"
                           Visibility="{Binding Error, Converter={StaticResource EmptyToCollapsed}}" />
            </Grid>
        </Button>

        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                <Setter TargetName="UninstallButton" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--  One row inside a publisher's suite: a product of its own, or a
          family of them - so it has its own icon, smaller than the suite's
          so the suite still reads as the thing these hang off, and a family
          among them opens to its versions like a family anywhere else.
          Otherwise the installed row again, one step in.  -->
    <DataTemplate x:Key="SuiteChildTemplate">
        <StackPanel>
            <Button x:Name="Row"
                    Style="{StaticResource RowButton}"
                    Tag="row"
                    Padding="16,8,16,9"
                    AutomationProperties.Name="{Binding Title}"
                    AutomationProperties.HelpText="{Binding Subtitle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="RowAction" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource RowIconTile}"
                            Width="28"
                            Height="28"
                            CornerRadius="7"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                        <Grid>
                            <TextBlock x:Name="Initial"
                                       Text="{Binding Initial}"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="14"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Image Source="{Binding Icon}"
                                   Width="24"
                                   Height="24"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="13.5"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,2,0,0"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding Subtitle}" />
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding IdText}" />

                    <StackPanel x:Name="SingleActions"
                                Grid.Column="3"
                                DataContext="{Binding Lead}"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding Status}"
                                   Visibility="{Binding Status, Converter={StaticResource EmptyToCollapsed}}" />
                        <Button Tag="uninstall"
                                Height="30"
                                Padding="14,0"
                                FontSize="13"
                                Content="Uninstall">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PillButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <Viewbox x:Name="Chevron"
                             Grid.Column="3"
                             Width="16"
                             Height="16"
                             Margin="8,0,10,0"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             Visibility="Collapsed"
                             RenderTransformOrigin="0.5,0.5">
                        <Path Style="{StaticResource Icon}"
                              Data="{StaticResource IconChevronDown}"
                              Stroke="{DynamicResource TextSecondaryBrush}" />
                    </Viewbox>

                    <ProgressBar x:Name="LeadBar"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Grid.ColumnSpan="3"
                                 DataContext="{Binding Lead}"
                                 Margin="0,9,0,0"
                                 Style="{StaticResource OperationProgressBar}" />

                    <TextBlock x:Name="LeadError"
                               Grid.Row="2"
                               Grid.Column="1"
                               Grid.ColumnSpan="3"
                               DataContext="{Binding Lead}"
                               Margin="0,8,0,0"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ErrorBrush}"
                               Text="{Binding Error}"
                               Visibility="{Binding Error, Converter={StaticResource EmptyToCollapsed}}" />
                </Grid>
            </Button>

            <!--  Its versions, one step further in than itself.  -->
            <ItemsControl x:Name="Members"
                          Margin="36,0,0,0"
                          Visibility="Collapsed"
                          ItemsSource="{Binding Members}"
                          ItemTemplate="{StaticResource InstalledVersionTemplate}" />
        </StackPanel>

        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasIcon}" Value="True">
                <Setter TargetName="Initial" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsGroup}" Value="True">
                <Setter TargetName="SingleActions" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="LeadBar" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="LeadError" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Chevron" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                <Setter TargetName="Members" Property="Visibility" Value="Visible" />
                <Setter TargetName="Chevron" Property="RenderTransform">
                    <Setter.Value>
                        <RotateTransform Angle="180" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="InstalledRowTemplate">
        <StackPanel>
            <!--  The row opens the package's page, or opens the family out;
                  ManageView.OnRowButtonClick decides which from what it is.
                  The parts that belong to the package alone - the button, the
                  bar, the status and the reason - read the lead directly.  -->
            <Button x:Name="Row"
                    Style="{StaticResource RowButton}"
                    Tag="row"
                    AutomationProperties.Name="{Binding Title}"
                    AutomationProperties.HelpText="{Binding Subtitle}">
                <Grid>
                    <!--  The action column is shared across every row of the
                          list (InstalledList is the scope), so a chevron, a
                          button, or a button with a status beside it all take
                          the same width and the id column stays put.  -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="RowAction" />
                    </Grid.ColumnDefinitions>
                    <!--  Everything below defaults to row 0; row 1 is the bar, and
                          row 2 the reason an uninstall could not go through.  -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource RowIconTile}">
                        <Grid>
                            <TextBlock x:Name="Initial"
                                       Text="{Binding Initial}"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="18"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Image Source="{Binding Icon}"
                                   Width="32"
                                   Height="32"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,2,0,0"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding Subtitle}" />
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding IdText}" />

                    <StackPanel x:Name="SingleActions"
                                Grid.Column="3"
                                DataContext="{Binding Lead}"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding Status}"
                                   Visibility="{Binding Status, Converter={StaticResource EmptyToCollapsed}}" />
                        <Button Tag="uninstall"
                                Height="32"
                                Padding="16,0"
                                Content="Uninstall">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PillButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!--  A family's row has nothing to press: it opens. The
                          chevron turns to say which way.  -->
                    <Viewbox x:Name="Chevron"
                             Grid.Column="3"
                             Width="18"
                             Height="18"
                             Margin="8,0,10,0"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             Visibility="Collapsed"
                             RenderTransformOrigin="0.5,0.5">
                        <Path Style="{StaticResource Icon}"
                              Data="{StaticResource IconChevronDown}"
                              Stroke="{DynamicResource TextSecondaryBrush}" />
                    </Viewbox>

                    <ProgressBar x:Name="LeadBar"
                                 Grid.Row="1"
                                 Grid.ColumnSpan="4"
                                 DataContext="{Binding Lead}"
                                 Margin="0,10,0,0"
                                 Style="{StaticResource OperationProgressBar}" />

                    <TextBlock x:Name="LeadError"
                               Grid.Row="2"
                               Grid.Column="1"
                               Grid.ColumnSpan="3"
                               DataContext="{Binding Lead}"
                               Margin="14,8,0,0"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ErrorBrush}"
                               Text="{Binding Error}"
                               Visibility="{Binding Error, Converter={StaticResource EmptyToCollapsed}}" />
                </Grid>
            </Button>

            <ItemsControl x:Name="Members"
                          Visibility="Collapsed"
                          ItemsSource="{Binding Members}"
                          ItemTemplate="{StaticResource InstalledVersionTemplate}" />

            <!--  A suite opens to its families and products instead.  -->
            <ItemsControl x:Name="Children"
                          Visibility="Collapsed"
                          ItemsSource="{Binding Children}"
                          ItemTemplate="{StaticResource SuiteChildTemplate}" />
        </StackPanel>

        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasIcon}" Value="True">
                <Setter TargetName="Initial" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsGroup}" Value="True">
                <Setter TargetName="SingleActions" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="LeadBar" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="LeadError" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Chevron" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                <Setter TargetName="Members" Property="Visibility" Value="Visible" />
                <Setter TargetName="Chevron" Property="RenderTransform">
                    <Setter.Value>
                        <RotateTransform Angle="180" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsExpanded}" Value="True" />
                    <Condition Binding="{Binding IsSuite}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Members" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Children" Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
            <!--  The first row needs no separator above it  -->
            <DataTrigger Value="0"
                         Binding="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}">
                <Setter TargetName="Row" Property="BorderThickness" Value="0" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
