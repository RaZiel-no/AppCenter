<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrl="clr-namespace:AppCenter.Controls"
                    xmlns:views="clr-namespace:AppCenter.Views">

    <ctrl:EmptyStringToCollapsedConverter x:Key="EmptyToCollapsed" />
    <ctrl:IconKeyConverter x:Key="IconKey" />

    <!--  ============================================================
          Keyboard focus. WPF's own focus visual is a one-pixel dotted
          rectangle, drawn in the text colour - all but invisible on this
          chrome. These draw a two-pixel accent ring just outside the
          control instead, rounded to match it. Only keyboard focus shows
          them; a click never does.
          ============================================================  -->

    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="2"
                            CornerRadius="11"
                            Margin="-3"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FocusRingRound">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="2"
                            CornerRadius="24"
                            Margin="-3"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============================================================
          A list row that opens something when it is pressed.

          A Button rather than a Border with a mouse handler, so a row
          can be reached with Tab, pressed with Enter or Space, read by a
          screen reader and driven by automation - a Border can be none
          of those. The row's own buttons sit inside it and take their
          clicks first; what reaches the row is a press on the row.

          BorderBrush and BorderThickness are the row's to set: the list
          draws its dividers as a top border on every row but the first.
          ============================================================  -->

    <Style x:Key="RowButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHoverBgBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============================================================
          A screenshot thumbnail on the detail page. A Button for the
          same reason as the row: it is a thing to press, and a picture
          on its own is not one to a keyboard or a screen reader. No
          chrome of its own - the content draws its rounded frame - and
          the hover is the picture brightening a touch, not a box
          appearing around it.
          ============================================================  -->

    <Style x:Key="ScreenshotButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter x:Name="Content" Opacity="0.92" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Content" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============================================================
          Page header - the strip a page keeps in place while its body
          scrolls: title, primary actions, a filter bar.

          Padded on the right by the scrollbar's width as well as the
          gutter, so its content lines up with the body's, which sits
          in a viewport that much narrower. The hairline underneath only
          appears once the body has moved: at the top the two read as
          one page, and a line between them would just be a stripe.
          ============================================================  -->

    <Style x:Key="PageHeader" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ContentBgBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="24,4,38,16" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsScrolled, RelativeSource={RelativeSource AncestorType=views:PageView}}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  Page footer - the header's mirror: a strip a page keeps in place
          at its foot while the body scrolls above it. No hairline, unlike
          the header: the picker is a bordered card with the page's own
          background around it, so the cards scrolling up behind it already
          read as passing under something. Explore's category picker lives
          in one.  -->

    <Style x:Key="PageFooter" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ContentBgBrush}" />
        <Setter Property="Padding" Value="24,14,38,16" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!--  The body under a page header. Its scrollbar is always allotted its
          width - hidden rather than gone when there is nothing to scroll -
          so the content never shifts sideways by half a scrollbar between a
          short page and a long one, and stays under the header's.

          A ScrollViewer ignores touch unless told which way it may be panned:
          without a PanningMode a finger dragged down the page is promoted to
          a mouse drag, which scrolls nothing. Vertical only, to match the
          disabled horizontal bar. A tap that never moves still reaches the
          card or button under it.  -->

    <Style x:Key="PageBody" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Visible" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="PanningMode" Value="VerticalOnly" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <!--  ============================================================
          Skeleton - the shape of a list before the list has arrived.
          Grey bars where the icon, the name and the version will be,
          breathing, so a page waiting on winget looks like a page
          loading rather than a page with nothing on it.
          ============================================================  -->

    <Style x:Key="SkeletonBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ButtonBgBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Height" Value="10" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="SkeletonPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="1"
                                         To="0.45"
                                         Duration="0:0:0.9"
                                         AutoReverse="True"
                                         RepeatBehavior="Forever" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!--  One placeholder row: a tile, a name-length bar, a version-length bar.  -->
    <ControlTemplate x:Key="SkeletonRow" TargetType="ContentControl">
        <Grid Margin="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="38" Height="38" CornerRadius="9" Background="{DynamicResource ButtonBgBrush}" />
            <StackPanel Grid.Column="1" Margin="14,4,0,0" VerticalAlignment="Center">
                <!--  Binding rather than TemplateBinding: the width arrives as a
                      string in Tag, and only Binding converts it.  -->
                <Border Style="{StaticResource SkeletonBar}"
                        Width="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                <Border Style="{StaticResource SkeletonBar}" Width="70" Height="8" Margin="0,9,0,0" />
            </StackPanel>
        </Grid>
    </ControlTemplate>

    <!--  One placeholder field for a package's Details: a label-length bar
          and a value-length bar, in the columns the real rows use.  -->
    <ControlTemplate x:Key="SkeletonField" TargetType="ContentControl">
        <Grid Margin="16,13">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SkeletonBar}" Width="84" />
            <Border Grid.Column="1"
                    Style="{StaticResource SkeletonBar}"
                    Width="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
        </Grid>
    </ControlTemplate>

    <!--  ============================================================
          Operation progress bar
          Expects an AppPackage as its DataContext, and takes all three
          of its cues from there: whether to show at all, how far along
          to draw, and whether to breathe instead of advancing. Those
          are painted on by OperationService.Paint, so a row rebuilt
          after navigating away picks the bar up where it left off.
          ============================================================  -->

    <Style x:Key="OperationProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="3" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Value" Value="{Binding Progress}" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource GreenBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <!--  Hand-rolled because the stock template paints its own
                      gradients and border, which none of the four themes here
                      would match. PART_Track and PART_Indicator are the names
                      ProgressBar itself measures and sizes.  -->
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" />
                        <Border x:Name="PART_Track" />
                        <Border x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="2" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
            <!--  Held at the last honest position and breathing: winget is
                  inside a step that reports nothing until it ends.  -->
            <DataTrigger Binding="{Binding IsProgressPulsing}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard Name="Breathing">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="1"
                                             To="0.35"
                                             Duration="0:0:0.85"
                                             AutoReverse="True"
                                             RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="Breathing" />
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  ============================================================
          Icons
          Geometries are authored on a 24x24 grid and drawn with
          Stretch=None so their bounds never depend on the path's ink
          extents (a single horizontal line has zero height, which
          would break Uniform stretching). Wrap in a Viewbox to resize.
          ============================================================  -->

    <Style x:Key="Icon" TargetType="Path">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
    </Style>

    <!--  ============================================================
          Typography
          ============================================================  -->

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!--  ============================================================
          Scrollbars - thin, dark, no stepper arrows
          ============================================================  -->

    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd"
                            Background="{DynamicResource ScrollThumbBrush}"
                            CornerRadius="4"
                            Margin="3,0" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="14" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="14" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                        </Trigger>
                        <!--  Nothing to scroll: keep the width, lose the thumb.
                              A page body always reserves the bar (see PageBody),
                              and a full-height thumb on a short page would read
                              as a scrollbar for a page that does not scroll.  -->
                        <Trigger Property="Maximum" Value="0">
                            <Setter TargetName="PART_Track" Property="Visibility" Value="Hidden" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============================================================
          Sidebar navigation item
          Geometry travels in Tag so one template serves every entry.
          ============================================================  -->

    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root"
                            Background="Transparent"
                            CornerRadius="8"
                            Height="42"
                            Margin="8,1"
                            Padding="12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Viewbox Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center">
                                <Path x:Name="Icon"
                                      Style="{StaticResource Icon}"
                                      Data="{TemplateBinding Tag}"
                                      Stroke="{TemplateBinding Foreground}" />
                            </Viewbox>

                            <TextBlock Grid.Column="1"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       Text="{TemplateBinding Content}" />

                            <!--  Pending-update count, hidden while it is zero  -->
                            <Border Grid.Column="2"
                                    x:Name="Badge"
                                    Background="{DynamicResource GreenBrush}"
                                    CornerRadius="9"
                                    MinWidth="18"
                                    Height="18"
                                    Padding="6,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding Path=(ctrl:Nav.BadgeText), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyToCollapsed}}">
                                <!--  Centred on the ink rather than the line. Digits
                                      stand on the baseline with the descender's
                                      room under them, so a line centred in the
                                      pill puts them a pixel low. Moved by a
                                      transform rather than a margin: a margin is
                                      halved by the centring and then rounded,
                                      and lands on 0 or 2.  -->
                                <TextBlock x:Name="BadgeCount"
                                           Foreground="White"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text="{Binding Path=(ctrl:Nav.BadgeText), RelativeSource={RelativeSource TemplatedParent}}">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform Y="-1" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!--  Digits are all one width, and a "1" stands to the
                              right of its slot: its flag is the only part on the
                              left. Alone in the pill that reads as off-centre.  -->
                        <Trigger Property="ctrl:Nav.BadgeText" Value="1">
                            <Setter TargetName="BadgeCount" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="-1" Y="-1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============================================================
          Window chrome buttons - round, GNOME style
          ============================================================  -->

    <Style x:Key="WindowButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingRound}" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{DynamicResource ButtonBgBrush}"
                            CornerRadius="15">
                        <Viewbox Width="16" Height="16">
                            <Path Style="{StaticResource Icon}"
                                  Data="{TemplateBinding Tag}"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.7" />
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBgBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonPressedBgBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{DynamicResource ButtonBgBrush}"
                            CornerRadius="15">
                        <Viewbox Width="16" Height="16">
                            <Path x:Name="Ic"
                                  Style="{StaticResource Icon}"
                                  Data="{TemplateBinding Tag}"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.7" />
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFC42B1C" />
                            <Setter TargetName="Ic" Property="Stroke" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFA02216" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============================================================
          Buttons
          ============================================================  -->

    <!--  Default grey pill: "Update", "Uninstall", "Check for updates"  -->
    <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{DynamicResource ButtonBgBrush}"
                            BorderBrush="{DynamicResource ButtonBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBgBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonPressedBgBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Green call to action: "Update all"  -->
    <Style x:Key="GreenButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{DynamicResource GreenBrush}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GreenHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Outlined, sits on the Explore banner: "Discover more"  -->
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="#26FFFFFF"
                            BorderBrush="#66FFFFFF"
                            BorderThickness="1"
                            CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#40FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Round and icon-only: the Back arrow at the head of a page. The
          geometry travels in Tag, like the window buttons.  -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingRound}" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{DynamicResource ButtonBgBrush}"
                            BorderBrush="{DynamicResource ButtonBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="18">
                        <Viewbox Width="17" Height="17">
                            <Path Style="{StaticResource Icon}"
                                  Data="{TemplateBinding Tag}"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.7" />
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBgBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonPressedBgBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Carousel arrows  -->
    <Style x:Key="CarouselArrow" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingRound}" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="#99000000" CornerRadius="18">
                        <Viewbox Width="18" Height="18">
                            <Path Style="{StaticResource Icon}"
                                  Data="{TemplateBinding Tag}"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.8" />
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#CC000000" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Lightbox arrows and close: the carousel's, larger, and drawn for
          the dark scrim they sit on - a pale disc rather than a dark one,
          so they read against a dark screenshot as well as a light one.
          An arrow with nowhere to go dims rather than disappears: it still
          says which way the set runs.  -->
    <Style x:Key="LightboxButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingRound}" />
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="#2EFFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="24">
                        <Viewbox Width="22" Height="22">
                            <Path Style="{StaticResource Icon}"
                                  Data="{TemplateBinding Tag}"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.8" />
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#4DFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#66FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============================================================
          Links
          Accent coloured and flat, with the underline kept for hover so
          a row of URLs does not turn into a wall of rules.
          ============================================================  -->

    <Style x:Key="LinkText" TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="TextDecorations" Value="None" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
                <Setter Property="TextDecorations" Value="Underline" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  ============================================================
          Search box, with watermark
          ============================================================  -->

    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{DynamicResource SearchBgBrush}"
                            BorderBrush="{DynamicResource SearchBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="19">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Viewbox Grid.Column="0" Width="16" Height="16" Margin="14,0,0,0">
                                <Path Style="{StaticResource Icon}"
                                      Data="{StaticResource IconSearch}"
                                      Stroke="{DynamicResource TextSecondaryBrush}" />
                            </Viewbox>

                            <Grid Grid.Column="1" Margin="10,0,0,0">
                                <!--  Placeholder text travels in Tag  -->
                                <TextBlock x:Name="Watermark"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           Visibility="Collapsed"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="14"
                                           IsHitTestVisible="False" />
                                <ScrollViewer x:Name="PART_ContentHost"
                                              VerticalAlignment="Center"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden" />
                            </Grid>

                            <!--  Wired up in code-behind via Template.FindName  -->
                            <Button x:Name="PART_ClearButton"
                                    Grid.Column="2"
                                    Width="26"
                                    Height="26"
                                    Margin="0,0,8,0"
                                    Cursor="Hand"
                                    Focusable="False">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent">
                                            <Viewbox Width="17" Height="17">
                                                <Path x:Name="Ic"
                                                      Style="{StaticResource Icon}"
                                                      Data="{StaticResource IconClearCircle}"
                                                      Stroke="{DynamicResource TextSecondaryBrush}" />
                                            </Viewbox>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Ic" Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Watermark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Compact variant used by the "Search installed apps" field  -->
    <Style x:Key="SmallSearchBox" TargetType="TextBox" BasedOn="{StaticResource SearchBox}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="36" />
    </Style>

    <!--  ============================================================
          ComboBox - "Sort by" and "Package type"
          ============================================================  -->

    <Style x:Key="AppComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="6"
                            Margin="4,1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBgBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppComboBox" TargetType="ComboBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource AppComboBoxItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
                        <ToggleButton x:Name="Toggle"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd"
                                            Background="{DynamicResource ButtonBgBrush}"
                                            BorderBrush="{DynamicResource ButtonBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8" />
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBgBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter IsHitTestVisible="False"
                                          Margin="14,0,38,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />

                        <Viewbox Width="16" Height="16" Margin="0,0,12,0"
                                 HorizontalAlignment="Right" VerticalAlignment="Center"
                                 IsHitTestVisible="False">
                            <Path Style="{StaticResource Icon}"
                                  Data="{StaticResource IconChevronDown}"
                                  Stroke="{DynamicResource TextPrimaryBrush}" />
                        </Viewbox>

                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               Placement="Bottom"
                               PopupAnimation="Fade"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Background="{DynamicResource PopupBgBrush}"
                                    BorderBrush="{DynamicResource ButtonBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Margin="0,4,0,0"
                                    Padding="0,4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer PanningMode="VerticalOnly">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============================================================
          Toggle switch - "Show system packages"
          ============================================================  -->

    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingRound}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track"
                            Width="46"
                            Height="26"
                            CornerRadius="13"
                            Background="{DynamicResource ButtonBgBrush}"
                            BorderBrush="{DynamicResource ButtonBorderBrush}"
                            BorderThickness="1">
                        <Ellipse x:Name="Knob"
                                 Width="18"
                                 Height="18"
                                 Fill="{DynamicResource ToggleKnobBrush}"
                                 HorizontalAlignment="Left"
                                 Margin="3,0,0,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                            <Setter TargetName="Knob" Property="Fill" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============================================================
          Tooltip
          ============================================================  -->

    <Style TargetType="ToolTip">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource ButtonBgBrush}"
                            BorderBrush="{DynamicResource ButtonBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,6">
                        <ContentPresenter TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
                                          TextElement.FontFamily="{StaticResource AppFont}"
                                          TextElement.FontSize="12.5" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
