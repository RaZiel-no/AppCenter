<!--  ============================================================
      Dark - neutral and colder than Yaru: near-black blue-greys with
      a blue accent, for people who find the orange loud. Same key set
      as Colours/Ubuntu.xaml.
      ============================================================  -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Surfaces  -->
    <Color x:Key="ContentBgColor">#FF0D1117</Color>
    <Color x:Key="SidebarBgColor">#FF161B22</Color>
    <Color x:Key="CardBgColor">#FF161B22</Color>
    <Color x:Key="CardHoverBgColor">#FF1C2430</Color>
    <Color x:Key="CardBorderColor">#FF2A323D</Color>
    <Color x:Key="CardHoverBorderColor">#FF3D4A5C</Color>
    <Color x:Key="DividerColor">#FF262E38</Color>
    <Color x:Key="RowBgColor">#FF161B22</Color>
    <Color x:Key="RowHoverBgColor">#FF1C2430</Color>
    <Color x:Key="PopupBgColor">#FF1C2430</Color>
    <Color x:Key="DialogBgColor">#FF161B22</Color>

    <!--  Sidebar states  -->
    <Color x:Key="SidebarHoverColor">#FF212A36</Color>
    <Color x:Key="SidebarSelectedColor">#FF2A3542</Color>

    <!--  Text  -->
    <Color x:Key="TextPrimaryColor">#FFE6EDF3</Color>
    <Color x:Key="TextSecondaryColor">#FF9AA6B2</Color>
    <Color x:Key="TextMutedColor">#FF6E7681</Color>

    <!--  Accents  -->
    <Color x:Key="AccentColor">#FF3B82F6</Color>
    <Color x:Key="AccentHoverColor">#FF60A5FA</Color>
    <Color x:Key="GreenColor">#FF238636</Color>
    <Color x:Key="GreenHoverColor">#FF2EA043</Color>
    <!--  The danger red this palette's GitHub-dark lineage uses.  -->
    <Color x:Key="ErrorColor">#FFF85149</Color>

    <!--  Controls  -->
    <Color x:Key="ButtonBgColor">#FF21262D</Color>
    <Color x:Key="ButtonHoverBgColor">#FF2C333B</Color>
    <Color x:Key="ButtonPressedBgColor">#FF373E47</Color>
    <Color x:Key="ButtonBorderColor">#FF363E48</Color>
    <Color x:Key="SearchBgColor">#FF0B0F14</Color>
    <Color x:Key="SearchBorderColor">#FF363E48</Color>
    <Color x:Key="ScrollThumbColor">#FF373E47</Color>
    <Color x:Key="ScrollThumbHoverColor">#FF4A535E</Color>
    <Color x:Key="ToggleKnobColor">#FFC9D1D9</Color>

    <!--  Explore banner gradient: midnight blue into teal  -->
    <Color x:Key="BannerStop0Color">#FF10214A</Color>
    <Color x:Key="BannerStop1Color">#FF16456E</Color>
    <Color x:Key="BannerStop2Color">#FF2E9BC4</Color>

</ResourceDictionary>
