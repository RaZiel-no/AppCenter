<!--  ============================================================
      Terminal - the surprise. Phosphor green on black, amber for the
      accent, the way a VT220 did two-colour highlighting. A wink at
      what is actually underneath this storefront: winget in a console.
      Same key set as Colours/Ubuntu.xaml.
      ============================================================  -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Surfaces  -->
    <Color x:Key="ContentBgColor">#FF000000</Color>
    <Color x:Key="SidebarBgColor">#FF04120A</Color>
    <Color x:Key="CardBgColor">#FF04160B</Color>
    <Color x:Key="CardHoverBgColor">#FF072211</Color>
    <Color x:Key="CardBorderColor">#FF0E4A22</Color>
    <Color x:Key="CardHoverBorderColor">#FF1FBE52</Color>
    <Color x:Key="DividerColor">#FF0B3A1B</Color>
    <Color x:Key="RowBgColor">#FF04160B</Color>
    <Color x:Key="RowHoverBgColor">#FF072211</Color>
    <Color x:Key="PopupBgColor">#FF061C0D</Color>
    <Color x:Key="DialogBgColor">#FF061C0D</Color>

    <!--  Sidebar states  -->
    <Color x:Key="SidebarHoverColor">#FF08290F</Color>
    <Color x:Key="SidebarSelectedColor">#FF0C3D18</Color>

    <!--  Text  -->
    <Color x:Key="TextPrimaryColor">#FF33FF66</Color>
    <Color x:Key="TextSecondaryColor">#FF26B84C</Color>
    <Color x:Key="TextMutedColor">#FF16803A</Color>

    <!--  Accents: amber against the green, the second phosphor  -->
    <Color x:Key="AccentColor">#FFFFB000</Color>
    <Color x:Key="AccentHoverColor">#FFFFC94D</Color>
    <Color x:Key="GreenColor">#FF17A63F</Color>
    <Color x:Key="GreenHoverColor">#FF1FCC4E</Color>
    <!--  The third phosphor. Loud on purpose - it only ever appears on a row
          that failed, and it has to win against all this green.  -->
    <Color x:Key="ErrorColor">#FFFF4136</Color>

    <!--  Controls  -->
    <Color x:Key="ButtonBgColor">#FF07240F</Color>
    <Color x:Key="ButtonHoverBgColor">#FF0B3517</Color>
    <Color x:Key="ButtonPressedBgColor">#FF10461F</Color>
    <Color x:Key="ButtonBorderColor">#FF178C38</Color>
    <Color x:Key="SearchBgColor">#FF010A04</Color>
    <Color x:Key="SearchBorderColor">#FF178C38</Color>
    <Color x:Key="ScrollThumbColor">#FF12662B</Color>
    <Color x:Key="ScrollThumbHoverColor">#FF1CA843</Color>
    <Color x:Key="ToggleKnobColor">#FF33FF66</Color>

    <!--  Explore banner gradient: black into full phosphor  -->
    <Color x:Key="BannerStop0Color">#FF000000</Color>
    <Color x:Key="BannerStop1Color">#FF063D18</Color>
    <Color x:Key="BannerStop2Color">#FF1FD455</Color>

</ResourceDictionary>
