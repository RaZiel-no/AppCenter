<!--  ============================================================
      Ubuntu - the Yaru dark palette the app was built in, and the
      default. Palette.xaml merges this one to seed the live brushes,
      so these values are also what "Ubuntu" restores to.

      Every theme file carries the same set of keys. ThemeService
      copies each XxxColor onto the matching XxxBrush in Palette.xaml,
      so a missing key here leaves that brush on the previous theme's
      colour - keep the four files in step.
      ============================================================  -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Surfaces  -->
    <Color x:Key="ContentBgColor">#FF161616</Color>
    <Color x:Key="SidebarBgColor">#FF2E2E2E</Color>
    <Color x:Key="CardBgColor">#FF242424</Color>
    <Color x:Key="CardHoverBgColor">#FF2E2E2E</Color>
    <Color x:Key="CardBorderColor">#FF3C3C3C</Color>
    <Color x:Key="CardHoverBorderColor">#FF565656</Color>
    <Color x:Key="DividerColor">#FF3A3A3A</Color>
    <Color x:Key="RowBgColor">#FF242424</Color>
    <Color x:Key="RowHoverBgColor">#FF2C2C2C</Color>
    <Color x:Key="PopupBgColor">#FF303030</Color>
    <Color x:Key="DialogBgColor">#FF2E2E2E</Color>

    <!--  Sidebar states  -->
    <Color x:Key="SidebarHoverColor">#FF383838</Color>
    <Color x:Key="SidebarSelectedColor">#FF454545</Color>

    <!--  Text  -->
    <Color x:Key="TextPrimaryColor">#FFFFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#FF9E9E9E</Color>
    <Color x:Key="TextMutedColor">#FF7A7A7A</Color>

    <!--  Accents  -->
    <Color x:Key="AccentColor">#FFE95420</Color>
    <Color x:Key="AccentHoverColor">#FFF06A3C</Color>
    <Color x:Key="GreenColor">#FF0E8420</Color>
    <Color x:Key="GreenHoverColor">#FF12A028</Color>

    <!--  Controls  -->
    <Color x:Key="ButtonBgColor">#FF383838</Color>
    <Color x:Key="ButtonHoverBgColor">#FF454545</Color>
    <Color x:Key="ButtonPressedBgColor">#FF505050</Color>
    <Color x:Key="ButtonBorderColor">#FF4A4A4A</Color>
    <Color x:Key="SearchBgColor">#FF1E1E1E</Color>
    <Color x:Key="SearchBorderColor">#FF4A4A4A</Color>
    <Color x:Key="ScrollThumbColor">#FF4A4A4A</Color>
    <Color x:Key="ScrollThumbHoverColor">#FF5E5E5E</Color>
    <Color x:Key="ToggleKnobColor">#FFCFCFCF</Color>

    <!--  Explore banner gradient: indigo to Ubuntu-adjacent green  -->
    <Color x:Key="BannerStop0Color">#FF2B1B6B</Color>
    <Color x:Key="BannerStop1Color">#FF1F4E64</Color>
    <Color x:Key="BannerStop2Color">#FF3FCC6E</Color>

</ResourceDictionary>
