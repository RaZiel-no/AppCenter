<views:PageView x:Class="AppCenter.Views.CategoryView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:views="clr-namespace:AppCenter.Views"
                xmlns:ctrl="clr-namespace:AppCenter.Controls">

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource PageHeader}">
            <Grid MaxWidth="900" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Only shown for a category reached from Explore; the sidebar
                      pages are their own way back.  -->
                <Button x:Name="BackButton"
                        Grid.Column="0"
                        Style="{StaticResource IconButton}"
                        Tag="{StaticResource IconArrowLeft}"
                        ToolTip="Back"
                        AutomationProperties.Name="Back"
                        Visibility="Collapsed"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0"
                        Click="OnBackClick" />

                <TextBlock x:Name="Title"
                           Grid.Column="1"
                           Style="{StaticResource PageTitle}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="Sort by"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               FontSize="13.5"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <ComboBox x:Name="SortBox"
                              Style="{StaticResource AppComboBox}"
                              Width="170"
                              SelectedIndex="0"
                              SelectionChanged="OnSortChanged">
                        <ComboBoxItem Content="Relevance" />
                        <ComboBoxItem Content="Name (A to Z)" />
                        <ComboBoxItem Content="Name (Z to A)" />
                        <ComboBoxItem Content="Publisher" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Style="{StaticResource PageBody}">
            <StackPanel MaxWidth="900" HorizontalAlignment="Stretch" Margin="24,10,24,40">
                <ctrl:AppGrid x:Name="Cards" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</views:PageView>
