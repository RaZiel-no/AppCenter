<views:PageView x:Class="AppCenter.Views.DetailView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:views="clr-namespace:AppCenter.Views">

    <DockPanel>

        <!--  ================= Header =================
              Pinned: who this is and what can be done to it stay in reach
              however far down the description the reader has got.  -->
        <Border DockPanel.Dock="Top" Style="{StaticResource PageHeader}" Padding="24,12,38,16">
            <Grid MaxWidth="900" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource IconButton}"
                        Tag="{StaticResource IconArrowLeft}"
                        ToolTip="Back"
                        AutomationProperties.Name="Back"
                        VerticalAlignment="Center"
                        Margin="0,0,18,0"
                        Click="OnBackClick" />

                <Border x:Name="IconTile"
                        Grid.Column="1"
                        Width="72"
                        Height="72"
                        CornerRadius="16"
                        VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{Binding FallbackBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <TextBlock x:Name="IconInitial"
                                   Text="{Binding Initial}"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="34"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Image Source="{Binding Icon}"
                               Width="60"
                               Height="60"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Margin="18,0,22,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                               Style="{StaticResource PageTitle}"
                               FontSize="26"
                               TextTrimming="CharacterEllipsis" />

                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock Text="{Binding Publisher}"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />

                        <Grid x:Name="BadgeVerified" Width="15" Height="15" Margin="7,1,0,0"
                              VerticalAlignment="Center" Visibility="Collapsed">
                            <Ellipse Fill="{DynamicResource GreenBrush}" />
                            <Viewbox Width="10" Height="10">
                                <Path Style="{StaticResource BadgeGlyph}" Data="{StaticResource GlyphCheck}" />
                            </Viewbox>
                        </Grid>

                        <Grid x:Name="BadgeStar" Width="15" Height="15" Margin="7,1,0,0"
                              VerticalAlignment="Center" Visibility="Collapsed">
                            <Ellipse Fill="{DynamicResource AccentBrush}" />
                            <Viewbox Width="10" Height="10">
                                <Path Style="{StaticResource BadgeGlyph}"
                                      Data="{StaticResource GlyphStarSolid}"
                                      Fill="White"
                                      StrokeThickness="0" />
                            </Viewbox>
                        </Grid>
                    </StackPanel>

                    <!--  Where this package stands on the machine: installed
                          and which version, or an update waiting. Hidden until
                          winget has answered, and for anything not installed -
                          the Install button says that on its own.  -->
                    <StackPanel x:Name="StateRow"
                                Orientation="Horizontal"
                                Margin="0,7,0,0"
                                Visibility="Collapsed">
                        <Ellipse x:Name="StateDot"
                                 Width="8"
                                 Height="8"
                                 Margin="1,1,7,0"
                                 VerticalAlignment="Center"
                                 Fill="{DynamicResource GreenBrush}" />
                        <TextBlock x:Name="StateText"
                                   FontSize="12.5"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>

                <!--  One primary action - Install, or Update when one is waiting
                      - with Uninstall beside it as the quiet alternative.  -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="InstallButton"
                            Style="{StaticResource GreenButton}"
                            MinWidth="120"
                            Height="40"
                            Content="Install"
                            Click="OnInstallClick" />
                    <Button x:Name="UpdateButton"
                            Style="{StaticResource GreenButton}"
                            Visibility="Collapsed"
                            MinWidth="120"
                            Height="40"
                            Content="Update"
                            Click="OnUpdateClick" />
                    <Button x:Name="UninstallButton"
                            Style="{StaticResource PillButton}"
                            Visibility="Collapsed"
                            Margin="10,0,0,0"
                            MinWidth="110"
                            Height="40"
                            Content="Uninstall"
                            Click="OnUninstallClick" />
                </StackPanel>

                <TextBlock x:Name="ProgressText"
                           Grid.Row="1"
                           Grid.ColumnSpan="4"
                           Visibility="Collapsed"
                           Margin="0,14,0,0"
                           FontSize="12.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />

                <!--  The page's DataContext is the package, so the bar already
                      has everything it needs to draw itself.  -->
                <ProgressBar Grid.Row="2"
                             Grid.ColumnSpan="4"
                             Margin="0,12,0,0"
                             Style="{StaticResource OperationProgressBar}" />
            </Grid>
        </Border>

        <!--  ================= Body =================  -->
        <ScrollViewer Style="{StaticResource PageBody}">
            <StackPanel MaxWidth="900" HorizontalAlignment="Stretch" Margin="24,20,24,40">

                <Border Background="{DynamicResource CardBgBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="22,20">
                    <TextBlock x:Name="Description"
                               FontSize="13.5"
                               LineHeight="21"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap" />
                </Border>

                <!--  ================= Metadata =================  -->
                <TextBlock Text="Details" Style="{StaticResource SectionTitle}" Margin="0,30,0,0" />

                <Border Margin="0,14,0,0"
                        Background="{DynamicResource CardBgBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="6,4">
                    <ItemsControl x:Name="Metadata">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="16,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Label}"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Grid Grid.Column="1">
                                        <TextBlock x:Name="PlainValue"
                                                   Text="{Binding Value}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap" />
                                        <!--  Tags are kept tight against the inline content so no
                                              stray indent whitespace lands in front of the URL.  -->
                                        <TextBlock x:Name="LinkValue"
                                                   Visibility="Collapsed"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   ><Hyperlink Style="{StaticResource LinkText}"
                                                               NavigateUri="{Binding Link}"
                                                               RequestNavigate="OnLinkClicked"
                                                               ><Run Text="{Binding Value}" /></Hyperlink></TextBlock>
                                    </Grid>
                                </Grid>

                                <DataTemplate.Triggers>
                                    <!--  Values winget prints as URLs open in the browser  -->
                                    <DataTrigger Binding="{Binding IsLink}" Value="True">
                                        <Setter TargetName="PlainValue" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="LinkValue" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</views:PageView>
