<views:PageView x:Class="AppCenter.Views.DetailView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:views="clr-namespace:AppCenter.Views">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!--  Stretch rather than Center - see ManageView: a centred panel is
              only as wide as its widest child, so a status line arriving would
              resize the page under the pointer.  -->
        <StackPanel MaxWidth="900" HorizontalAlignment="Stretch" Margin="24,0,24,40">

            <Button Style="{StaticResource PillButton}"
                    HorizontalAlignment="Left"
                    Margin="0,4,0,0"
                    Height="34"
                    Padding="14,0"
                    Click="OnBackClick">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="16" Height="16">
                        <Path Style="{StaticResource Icon}"
                              Data="{StaticResource IconArrowLeft}"
                              Stroke="{DynamicResource TextPrimaryBrush}" />
                    </Viewbox>
                    <TextBlock Text="Back" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!--  ================= Header =================  -->
            <Grid Margin="0,26,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="IconTile"
                        Grid.Column="0"
                        Width="88"
                        Height="88"
                        CornerRadius="18">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{Binding FallbackBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <TextBlock x:Name="IconInitial"
                                   Text="{Binding Initial}"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="40"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Image Source="{Binding Icon}"
                               Width="72"
                               Height="72"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="22,0,22,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource PageTitle}" TextTrimming="CharacterEllipsis" />

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding Publisher}"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />

                        <Grid x:Name="BadgeVerified" Width="15" Height="15" Margin="7,1,0,0"
                              VerticalAlignment="Center" Visibility="Collapsed">
                            <Ellipse Fill="{DynamicResource GreenBrush}" />
                            <Viewbox Width="10" Height="10">
                                <Path Style="{StaticResource BadgeGlyph}" Data="{StaticResource GlyphCheck}" />
                            </Viewbox>
                        </Grid>

                        <Grid x:Name="BadgeStar" Width="15" Height="15" Margin="7,1,0,0"
                              VerticalAlignment="Center" Visibility="Collapsed">
                            <Ellipse Fill="{DynamicResource AccentBrush}" />
                            <Viewbox Width="10" Height="10">
                                <Path Style="{StaticResource BadgeGlyph}"
                                      Data="{StaticResource GlyphStarSolid}"
                                      Fill="White"
                                      StrokeThickness="0" />
                            </Viewbox>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button x:Name="InstallButton"
                            Style="{StaticResource GreenButton}"
                            MinWidth="130"
                            Height="40"
                            Content="Install"
                            Click="OnInstallClick" />
                    <Button x:Name="UninstallButton"
                            Style="{StaticResource PillButton}"
                            Visibility="Collapsed"
                            MinWidth="130"
                            Height="40"
                            Content="Uninstall"
                            Click="OnUninstallClick" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="ProgressText"
                       Visibility="Collapsed"
                       Margin="0,16,0,0"
                       FontSize="12.5"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />

            <!--  The page's DataContext is the package, so the bar already has
                  everything it needs to draw itself.  -->
            <ProgressBar Margin="0,10,0,0"
                         Style="{StaticResource OperationProgressBar}" />

            <!--  ================= Description =================  -->
            <Border Margin="0,26,0,0"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="22,20">
                <TextBlock x:Name="Description"
                           FontSize="13.5"
                           LineHeight="21"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextWrapping="Wrap" />
            </Border>

            <!--  ================= Metadata =================  -->
            <TextBlock Text="Details" Style="{StaticResource SectionTitle}" Margin="0,30,0,0" />

            <Border Margin="0,14,0,0"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="6,4">
                <ItemsControl x:Name="Metadata">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="16,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Label}"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Grid Grid.Column="1">
                                    <TextBlock x:Name="PlainValue"
                                               Text="{Binding Value}"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextWrapping="Wrap" />
                                    <!--  Tags are kept tight against the inline content so no
                                          stray indent whitespace lands in front of the URL.  -->
                                    <TextBlock x:Name="LinkValue"
                                               Visibility="Collapsed"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               ><Hyperlink Style="{StaticResource LinkText}"
                                                           NavigateUri="{Binding Link}"
                                                           RequestNavigate="OnLinkClicked"
                                                           ><Run Text="{Binding Value}" /></Hyperlink></TextBlock>
                                </Grid>
                            </Grid>

                            <DataTemplate.Triggers>
                                <!--  Values winget prints as URLs open in the browser  -->
                                <DataTrigger Binding="{Binding IsLink}" Value="True">
                                    <Setter TargetName="PlainValue" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="LinkValue" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</views:PageView>
