<views:PageView x:Class="AppCenter.Views.ExploreView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:views="clr-namespace:AppCenter.Views"
                xmlns:ctrl="clr-namespace:AppCenter.Controls">

    <!--  No pinned header: the banner is the page's opening, and it scrolls
          with the rest. Styled as a body all the same, so its column sits
          exactly where every other page's does.  -->
    <ScrollViewer Style="{StaticResource PageBody}">
        <StackPanel MaxWidth="900" HorizontalAlignment="Stretch" Margin="24,4,24,40">

            <!--  ================= Featured banner =================  -->
            <Border Height="232"
                    CornerRadius="10"
                    Background="{DynamicResource BannerGradientBrush}">
                <Grid Margin="48,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="BannerTitle"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="30"
                                   Foreground="White"
                                   Text="Featured apps" />
                        <Button x:Name="DiscoverButton"
                                Style="{StaticResource GhostButton}"
                                Margin="0,22,0,0"
                                HorizontalAlignment="Left"
                                Foreground="White"
                                Content="Discover more"
                                Click="OnDiscoverClick" />
                    </StackPanel>

                    <ItemsControl x:Name="HighlightIcons"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  ItemTemplate="{StaticResource BannerTileTemplate}"
                                  Button.Click="OnHighlightClick">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </Border>

            <!--  ================= Card grid =================  -->
            <ctrl:AppGrid x:Name="Cards" Margin="0,32,0,0" />

            <!--  ================= Categories =================  -->
            <TextBlock Text="Categories" Style="{StaticResource SectionTitle}" Margin="0,38,0,0" />

            <Border Margin="0,14,0,0"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,16">
                <ItemsControl x:Name="Categories"
                              ItemTemplate="{StaticResource CategoryTileTemplate}"
                              Button.Click="OnCategoryClick">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!--  Five columns at the 900 the page is capped to,
                                  and fewer as it narrows. Not six: "Books and
                                  Reference" does not fit in a sixth of it, and
                                  a trimmed category name reads as a defect.  -->
                            <WrapPanel ItemWidth="172" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</views:PageView>
