<views:PageView x:Class="AppCenter.Views.ExploreView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:views="clr-namespace:AppCenter.Views"
                xmlns:ctrl="clr-namespace:AppCenter.Controls">

    <DockPanel>
        <!--  ================= Categories =================
              Pinned at the foot, not scrolled to. They used to be the last
              thing in the scroll, which meant going past every card to find
              out the catalogue had sections at all; docked here they keep
              their place at the bottom and stay in view while the banner
              and the cards scroll above them.  -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource PageFooter}">
            <Border MaxWidth="900"
                    HorizontalAlignment="Stretch"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,12">
                <ItemsControl x:Name="Categories"
                              ItemTemplate="{StaticResource CategoryTileTemplate}"
                              Button.Click="OnCategoryClick">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!--  Five columns at the 900 the page is capped to,
                                  and fewer as it narrows. Not six: "Books and
                                  Reference" does not fit in a sixth of it, and
                                  a trimmed category name reads as a defect.  -->
                            <WrapPanel ItemWidth="172" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Border>
        </Border>

        <ScrollViewer Style="{StaticResource PageBody}">
            <StackPanel MaxWidth="900" HorizontalAlignment="Stretch" Margin="24,4,24,40">

                <!--  ================= Featured banner =================  -->
                <Border Height="232"
                        CornerRadius="10"
                        Background="{DynamicResource BannerGradientBrush}">
                    <Grid Margin="48,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="BannerTitle"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="30"
                                       Foreground="White"
                                       Text="Featured apps" />
                            <Button x:Name="DiscoverButton"
                                    Style="{StaticResource GhostButton}"
                                    Margin="0,22,0,0"
                                    HorizontalAlignment="Left"
                                    Foreground="White"
                                    Content="Discover more"
                                    Click="OnDiscoverClick" />
                        </StackPanel>

                        <ItemsControl x:Name="HighlightIcons"
                                      Grid.Column="1"
                                      VerticalAlignment="Center"
                                      ItemTemplate="{StaticResource BannerTileTemplate}"
                                      Button.Click="OnHighlightClick">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!--  ================= Card grid =================  -->
                <ctrl:AppGrid x:Name="Cards" Margin="0,32,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</views:PageView>
