<views:PageView x:Class="AppCenter.Views.AboutView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:views="clr-namespace:AppCenter.Views">

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource PageHeader}">
            <Grid MaxWidth="900" HorizontalAlignment="Stretch">
                <TextBlock Text="About" Style="{StaticResource PageTitle}" />
            </Grid>
        </Border>

        <ScrollViewer Style="{StaticResource PageBody}">
        <StackPanel MaxWidth="900" HorizontalAlignment="Stretch" Margin="24,10,24,40">

            <Border
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="24,22">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <!--  The app's own icon, which is its own rounded tile.
                              Set from code: see IconService.AppIcon.  -->
                        <Image x:Name="Logo"
                               Width="56"
                               Height="56"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               AutomationProperties.Name="App Center" />
                        <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="App Center"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="22"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock x:Name="VersionText"
                                       Margin="0,3,0,0"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Margin="0,20,0,0"
                               FontSize="13.5"
                               LineHeight="21"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="A storefront for the Windows Package Manager, in the shape of Ubuntu's App Center. Browsing, search, installing, updating and removing all run through winget on this machine - nothing is bundled and no account is needed." />
                </StackPanel>
            </Border>

            <!--  ================= Updates =================
                  App Center's own releases, from GitHub. The winget package
                  follows each release weeks later, once its pull request is
                  merged; this is the same installer, sooner.  -->
            <TextBlock Text="Updates" Style="{StaticResource SectionTitle}" Margin="0,32,0,0" />

            <Border Margin="0,14,0,0"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="24,20">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Ellipse x:Name="UpdateDot"
                                 Width="8"
                                 Height="8"
                                 Margin="0,7,11,0"
                                 VerticalAlignment="Top"
                                 Fill="{DynamicResource TextMutedBrush}" />

                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="UpdateHeadline"
                                       FontSize="14.5"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="UpdateDetail"
                                       Margin="0,4,0,0"
                                       FontSize="13"
                                       LineHeight="19"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <!--  The download and hand-over, painted the way every row
                          paints an operation: onto a stand-in package keyed to
                          App Center's own id.  -->
                    <TextBlock x:Name="UpdateProgress"
                               Visibility="Collapsed"
                               Margin="0,12,0,0"
                               FontSize="12.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <ProgressBar x:Name="UpdateBar"
                                 Margin="0,10,0,0"
                                 Style="{StaticResource OperationProgressBar}" />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button x:Name="UpdateButton"
                                Style="{StaticResource GreenButton}"
                                Visibility="Collapsed"
                                Margin="0,0,10,0"
                                Content="Update"
                                Click="OnUpdateClick" />
                        <Button x:Name="ReleasePageButton"
                                Style="{StaticResource PillButton}"
                                Visibility="Collapsed"
                                Margin="0,0,10,0"
                                Click="OnReleasePageClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ReleasePageLabel" Text="What's new" VerticalAlignment="Center" />
                                <Viewbox Width="14" Height="14" Margin="7,1,0,0">
                                    <Path Style="{StaticResource Icon}"
                                          Data="{StaticResource IconExternalLink}"
                                          Stroke="{DynamicResource TextSecondaryBrush}" />
                                </Viewbox>
                            </StackPanel>
                        </Button>
                        <Button x:Name="CheckUpdatesButton"
                                Style="{StaticResource PillButton}"
                                Click="OnCheckClick">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16">
                                    <Path Style="{StaticResource Icon}"
                                          Data="{StaticResource IconRefresh}"
                                          Stroke="{DynamicResource TextPrimaryBrush}" />
                                </Viewbox>
                                <TextBlock Text="Check again" Margin="9,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border Height="1" Margin="0,20,0,0" Background="{DynamicResource DividerBrush}" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Check GitHub for a newer version when App Center starts"
                                       FontSize="13.5"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Margin="0,3,0,0"
                                       FontSize="12.5"
                                       LineHeight="18"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Text="One request to api.github.com per launch, and nothing sent but the version. Releases reach GitHub first; the winget package follows once its pull request is merged, which can take days." />
                        </StackPanel>

                        <CheckBox x:Name="CheckOnLaunch"
                                  Grid.Column="1"
                                  Style="{StaticResource ToggleSwitch}"
                                  Margin="18,0,0,0"
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="Check GitHub for a newer version when App Center starts"
                                  Checked="OnCheckOnLaunchToggled"
                                  Unchecked="OnCheckOnLaunchToggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" Margin="0,32,0,0" />

            <Border Margin="0,14,0,0"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="24,20">
                <StackPanel>
                    <TextBlock Text="The theme applies as you pick it, and is remembered for next time."
                               FontSize="13.5"
                               Foreground="{DynamicResource TextPrimaryBrush}" />

                    <ItemsControl x:Name="ThemeList"
                                  Margin="0,18,0,0"
                                  ItemTemplate="{StaticResource ThemeSwatchTemplate}"
                                  RadioButton.Checked="OnThemeChecked">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <TextBlock x:Name="ThemeBlurb"
                               Margin="0,14,0,0"
                               FontSize="12.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="Licence and origins" Style="{StaticResource SectionTitle}" Margin="0,32,0,0" />

            <Border Margin="0,14,0,0"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="24,20">
                <StackPanel>
                    <TextBlock FontSize="13.5"
                               LineHeight="21"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}">
                        App Center is free software, released under the GNU General Public License
                        version 3. You may use, study, share and modify it; anything you pass on has
                        to carry the same freedoms.
                        <Hyperlink Style="{StaticResource LinkText}"
                                   NavigateUri="license"
                                   RequestNavigate="OnLinkClicked">Read the licence</Hyperlink>
                    </TextBlock>

                    <TextBlock Margin="0,16,0,0"
                               FontSize="13.5"
                               LineHeight="21"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}">
                        It is modelled on
                        <Hyperlink Style="{StaticResource LinkText}"
                                   NavigateUri="https://github.com/ubuntu/app-center"
                                   RequestNavigate="OnLinkClicked">Ubuntu's App Center</Hyperlink>,
                        which Canonical publish under that same licence - taking anything weaker for
                        a piece of work that owes them its whole shape would not sit right. No code
                        is shared between the two: this is an independent Windows implementation, in
                        C# over winget rather than Dart over snapd, and it is neither affiliated with
                        nor endorsed by Canonical.
                    </TextBlock>

                    <TextBlock x:Name="AuthorText"
                               Margin="0,16,0,0"
                               FontSize="12.5"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <TextBlock Text="Environment" Style="{StaticResource SectionTitle}" Margin="0,32,0,0" />

            <Border Margin="0,14,0,0"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="6,4">
                <ItemsControl x:Name="Facts">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="16,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Label}"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Value}"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</views:PageView>
