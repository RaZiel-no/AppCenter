<views:PageView x:Class="AppCenter.Views.ManageView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:views="clr-namespace:AppCenter.Views">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!--  Stretch rather than Center: a centred panel takes the width of its
              widest child, so every new status line resized the whole page and
              slid it sideways. Stretched and capped, the column is always the
              same width - and WPF still centres what MaxWidth has clamped.  -->
        <StackPanel MaxWidth="900" HorizontalAlignment="Stretch" Margin="24,0,24,40">

            <TextBlock Text="Manage" Style="{StaticResource PageTitle}" Margin="0,4,0,0" />

            <!--  ================= Updates =================  -->
            <Grid Margin="0,28,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="UpdatesHeading"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Style="{StaticResource SectionTitle}"
                           Text="Updates available" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CheckButton"
                            Style="{StaticResource PillButton}"
                            Click="OnCheckForUpdates">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16">
                                <Path Style="{StaticResource Icon}"
                                      Data="{StaticResource IconRefresh}"
                                      Stroke="{DynamicResource TextPrimaryBrush}" />
                            </Viewbox>
                            <TextBlock Text="Check for updates" Margin="9,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="UpdateAllButton"
                            Style="{StaticResource GreenButton}"
                            Margin="10,0,0,0"
                            Click="OnUpdateAll">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16">
                                <Path Style="{StaticResource Icon}"
                                      Data="{StaticResource IconDownload}"
                                      Stroke="White" />
                            </Viewbox>
                            <TextBlock Text="Update all" Margin="9,0,0,0" VerticalAlignment="Center" Foreground="White" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!--  Only for what no row can say: the check for updates, a list
                  that could not be read, and how a finished run ended when the
                  rows are not already saying it. While winget is working, the
                  rows say it themselves - each one busy in turn, with its own
                  bar - and a failure is theirs too, in red, beside the package
                  it happened to. Collapsed when there is nothing left over to
                  say, so it takes no room.  -->
            <TextBlock x:Name="ProgressText"
                       Visibility="Collapsed"
                       Margin="0,10,0,0"
                       FontSize="12.5"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />

            <Border x:Name="UpdatesPanel"
                    Margin="0,16,0,0"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <ItemsControl x:Name="UpdatesList"
                              AlternationCount="4096"
                              ItemTemplate="{StaticResource UpdateRowTemplate}"
                              Button.Click="OnRowButtonClick"
                              MouseLeftButtonUp="OnRowClick" />
            </Border>

            <Border x:Name="UpdatesEmpty"
                    Visibility="Collapsed"
                    Margin="0,16,0,0"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20,22">
                <TextBlock x:Name="UpdatesEmptyText"
                           Text="Everything is up to date."
                           FontSize="13.5"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>

            <!--  ================= Installed =================  -->
            <TextBlock Text="Installed apps" Style="{StaticResource SectionTitle}" Margin="0,38,0,0" />

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="FilterBox"
                         Grid.Column="0"
                         Style="{StaticResource SmallSearchBox}"
                         Tag="Search installed apps"
                         Width="230"
                         TextChanged="OnFilterChanged" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Show system packages"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               FontSize="13.5"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <CheckBox x:Name="SystemToggle"
                              Style="{StaticResource ToggleSwitch}"
                              VerticalAlignment="Center"
                              Checked="OnFilterToggled"
                              Unchecked="OnFilterToggled" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Sort by"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               FontSize="13.5"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <ComboBox x:Name="InstalledSort"
                              Style="{StaticResource AppComboBox}"
                              Width="190"
                              SelectedIndex="0"
                              SelectionChanged="OnSortChanged">
                        <ComboBoxItem Content="Alphabetical (A to Z)" />
                        <ComboBoxItem Content="Alphabetical (Z to A)" />
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Border x:Name="InstalledPanel"
                    Margin="0,16,0,0"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <ItemsControl x:Name="InstalledList"
                              AlternationCount="4096"
                              ItemTemplate="{StaticResource InstalledRowTemplate}"
                              Button.Click="OnRowButtonClick" />
            </Border>

            <TextBlock x:Name="InstalledStatus"
                       Margin="4,14,0,0"
                       FontSize="12.5"
                       Foreground="{DynamicResource TextMutedBrush}" />
        </StackPanel>
    </ScrollViewer>
</views:PageView>
