<views:PageView x:Class="AppCenter.Views.GamesView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:views="clr-namespace:AppCenter.Views"
                xmlns:ctrl="clr-namespace:AppCenter.Controls">

    <views:PageView.Resources>
        <!--  A carousel slide. Entries carrying a "screenshot" in catalog.json
              show it; the rest keep the package's generated gradient, so the
              strip still reads as a set of distinct panels either way.  -->
        <DataTemplate x:Key="SlideTemplate">
            <Border CornerRadius="8" Background="{Binding FallbackBrush}" ClipToBounds="True">
                <Grid>
                    <Image Source="{Binding Screenshot}"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <!--  Scrim. A flat gradient needs a little; a photograph
                          needs a lot, and needs it heavier at the bottom where
                          the summary sits.  -->
                    <Border x:Name="Scrim" Background="#55000000" />

                    <StackPanel VerticalAlignment="Center" Margin="30,0">
                        <TextBlock Text="{Binding Name}"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="46"
                                   Foreground="White"
                                   TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Summary}"
                                   Margin="0,8,0,0"
                                   FontSize="14"
                                   Foreground="#FFE0E0E0"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasScreenshot}" Value="True">
                    <Setter TargetName="Scrim" Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#66000000" Offset="0" />
                                <GradientStop Color="#8C000000" Offset="0.55" />
                                <GradientStop Color="#B3000000" Offset="1" />
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="PeekTemplate">
            <Border CornerRadius="8" Background="{Binding FallbackBrush}" Opacity="0.45" ClipToBounds="True">
                <Image Source="{Binding Screenshot}"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
        </DataTemplate>

        <!--  One frame of the carousel: the slide, and the two neighbours
              peeking in from either side. It is a template rather than inline
              layout because a transition needs two of these at once - the
              outgoing frame stays on screen, underneath the incoming one,
              until it has finished fading out.  -->
        <DataTemplate x:Key="StripTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="86" />
                </Grid.ColumnDefinitions>

                <ContentControl Grid.Column="0"
                                Content="{Binding Previous}"
                                Margin="0,24,10,24"
                                ContentTemplate="{StaticResource PeekTemplate}" />

                <ContentControl Grid.Column="1"
                                Content="{Binding Current}"
                                ContentTemplate="{StaticResource SlideTemplate}" />

                <ContentControl Grid.Column="2"
                                Content="{Binding Next}"
                                Margin="10,24,0,24"
                                ContentTemplate="{StaticResource PeekTemplate}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="DotTemplate">
            <Ellipse x:Name="Dot"
                     Width="9"
                     Height="9"
                     Margin="5,0"
                     Fill="{DynamicResource TextMutedBrush}" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Active}" Value="True">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </views:PageView.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource PageHeader}">
            <Grid MaxWidth="900" HorizontalAlignment="Stretch">
                <TextBlock Text="Games" Style="{StaticResource PageTitle}" />
            </Grid>
        </Border>

        <ScrollViewer Style="{StaticResource PageBody}">
        <StackPanel MaxWidth="900" HorizontalAlignment="Stretch" Margin="24,6,24,40">

            <!--  ================= Carousel =================
                  Clipped so the two frames can drift past the edges during a
                  transition without bleeding over the page beside them.  -->
            <Grid Height="250" ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="86" />
                </Grid.ColumnDefinitions>

                <!--  The frame on its way out, underneath the one coming in.
                      Empty and invisible until the first transition.  -->
                <ContentControl x:Name="OutgoingStrip"
                                Grid.ColumnSpan="3"
                                Opacity="0"
                                IsHitTestVisible="False"
                                ContentTemplate="{StaticResource StripTemplate}">
                    <ContentControl.RenderTransform>
                        <TranslateTransform />
                    </ContentControl.RenderTransform>
                </ContentControl>

                <ContentControl x:Name="CurrentStrip"
                                Grid.ColumnSpan="3"
                                ContentTemplate="{StaticResource StripTemplate}">
                    <ContentControl.RenderTransform>
                        <TranslateTransform />
                    </ContentControl.RenderTransform>
                </ContentControl>

                <!--  Outside both frames, so they stay put while the slides move.  -->
                <Button Grid.Column="1"
                        Style="{StaticResource CarouselArrow}"
                        Tag="{StaticResource IconChevronLeft}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="-18,0,0,0"
                        Click="OnPreviousClick" />

                <Button Grid.Column="1"
                        Style="{StaticResource CarouselArrow}"
                        Tag="{StaticResource IconChevronRight}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,-18,0"
                        Click="OnNextClick" />
            </Grid>

            <ItemsControl x:Name="Dots"
                          Margin="0,16,0,0"
                          HorizontalAlignment="Center"
                          ItemTemplate="{StaticResource DotTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!--  ================= Top rated =================  -->
            <TextBlock Text="Top Rated" Style="{StaticResource SectionTitle}" Margin="0,34,0,0" />
            <ctrl:AppGrid x:Name="Cards" Margin="0,18,0,0" />
        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</views:PageView>
