<views:PageView x:Class="AppCenter.Views.SearchView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:views="clr-namespace:AppCenter.Views"
                xmlns:ctrl="clr-namespace:AppCenter.Controls">

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource PageHeader}">
            <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">
                <TextBlock x:Name="Title" Style="{StaticResource PageTitle}" TextTrimming="CharacterEllipsis" />

                <TextBlock x:Name="Status"
                           Margin="0,8,0,0"
                           FontSize="13.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <ScrollViewer Style="{StaticResource PageBody}">
            <StackPanel MaxWidth="900" HorizontalAlignment="Stretch" Margin="24,10,24,40">
                <ctrl:AppGrid x:Name="Cards" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</views:PageView>
