<views:PageView x:Class="AppCenter.Views.SearchView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:views="clr-namespace:AppCenter.Views"
                xmlns:ctrl="clr-namespace:AppCenter.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="900" HorizontalAlignment="Center" Margin="24,0,24,40">

            <TextBlock x:Name="Title" Style="{StaticResource PageTitle}" Margin="0,4,0,0" />

            <TextBlock x:Name="Status"
                       Margin="0,10,0,0"
                       FontSize="13.5"
                       Foreground="{DynamicResource TextSecondaryBrush}" />

            <ctrl:AppGrid x:Name="Cards" Margin="0,22,0,0" />
        </StackPanel>
    </ScrollViewer>
</views:PageView>
