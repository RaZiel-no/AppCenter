<Window x:Class="AppCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ctrl="clr-namespace:AppCenter.Controls"
        Title="App Center"
        Width="1340"
        Height="860"
        MinWidth="940"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource AppFont}"
        Background="{DynamicResource ContentBgBrush}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <!--  The one pixel of glass is what keeps WindowChrome on the DWM path.
          With none, it draws the window's shape itself with a window region,
          which costs tens of milliseconds at launch and again at every step of
          a resize; with any, it asks DWM, which is free and draws the shadow
          every other window has. The pixel is under the opaque background and
          never seen. The corners stay square: see KeepCornersSquare.  -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0,0,0,1"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="208" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ================= Sidebar =================  -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBgBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnTitleBarMouseDown">
                    <!--  Icon overlaid rather than in a StackPanel, so it can sit on the
                          same left edge as the nav icons below without pushing the
                          centred title off centre. NavItem is Margin 8 + Padding 12 on a
                          20px icon, so its centre line is at 30; 18 + 12 puts this there.  -->
                    <Grid>
                        <!--  Decoded by the warm-up, off the UI thread; the
                              constructor sets it. See Warmup.DecodeLogo.  -->
                        <Image x:Name="Logo"
                               Width="24"
                               Height="24"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="18,0,0,0"
                               RenderOptions.BitmapScalingMode="HighQuality" />

                        <TextBlock Text="App Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="0,6,0,0">
                    <!--  Checked is the navigation; Click is for the entry that
                          is already checked, which Checked never fires for. See
                          OnNavClick.  -->
                    <RadioButton x:Name="NavExplore"
                                 Style="{StaticResource NavItem}"
                                 GroupName="Nav"
                                 Content="Explore"
                                 Tag="{StaticResource IconCompass}"
                                 IsChecked="True"
                                 Checked="OnNavChecked"
                                 Click="OnNavClick" />
                    <RadioButton x:Name="NavFeatured"
                                 Style="{StaticResource NavItem}"
                                 GroupName="Nav"
                                 Content="Featured"
                                 Tag="{StaticResource IconStar}"
                                 Checked="OnNavChecked"
                                 Click="OnNavClick" />
                    <RadioButton x:Name="NavProductivity"
                                 Style="{StaticResource NavItem}"
                                 GroupName="Nav"
                                 Content="Productivity"
                                 Tag="{StaticResource IconClock}"
                                 Checked="OnNavChecked"
                                 Click="OnNavClick" />
                    <RadioButton x:Name="NavDevelopment"
                                 Style="{StaticResource NavItem}"
                                 GroupName="Nav"
                                 Content="Development"
                                 Tag="{StaticResource IconPencil}"
                                 Checked="OnNavChecked"
                                 Click="OnNavClick" />
                    <RadioButton x:Name="NavGames"
                                 Style="{StaticResource NavItem}"
                                 GroupName="Nav"
                                 Content="Games"
                                 Tag="{StaticResource IconGamepad}"
                                 Checked="OnNavChecked"
                                 Click="OnNavClick" />
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,0,0,14">
                    <!--  What winget is doing right now, from wherever it was
                          started. An install begun on an app's page carries on
                          after the page is left, and this is the one place it
                          can be seen to. The bar is the same one the rows draw,
                          painted onto a stand-in package keyed to the operation.
                          Stays a moment after the work ends to say how it went,
                          then goes.  -->
                    <Border x:Name="Activity"
                            Visibility="Collapsed"
                            Margin="8,0,8,10"
                            Padding="12,10,12,11"
                            CornerRadius="8"
                            Background="{DynamicResource SidebarHoverBrush}">
                        <StackPanel>
                            <TextBlock x:Name="ActivityText"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ActivityDetail"
                                       Margin="0,2,0,0"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource EmptyToCollapsed}}" />
                            <ProgressBar x:Name="ActivityBar"
                                         Margin="0,8,0,0"
                                         Style="{StaticResource OperationProgressBar}" />
                        </StackPanel>
                    </Border>

                    <RadioButton x:Name="NavManage"
                                 Style="{StaticResource NavItem}"
                                 GroupName="Nav"
                                 Content="Manage"
                                 Tag="{StaticResource IconGrid}"
                                 Checked="OnNavChecked"
                                 Click="OnNavClick" />
                    <RadioButton x:Name="NavAbout"
                                 Style="{StaticResource NavItem}"
                                 GroupName="Nav"
                                 Content="About"
                                 Tag="{StaticResource IconAbout}"
                                 Checked="OnNavChecked"
                                 Click="OnNavClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  ================= Content column =================  -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Top bar doubles as the drag handle, since there is no title bar  -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnTitleBarMouseDown">
                <!--  The watermark is only paint; the automation name is what
                      a screen reader has to go on.  -->
                <TextBox x:Name="SearchBox"
                         Style="{StaticResource SearchBox}"
                         Tag="Search for apps"
                         AutomationProperties.Name="Search for apps"
                         Width="420"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         TextChanged="OnSearchTextChanged"
                         KeyDown="OnSearchKeyDown" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">
                    <Button Style="{StaticResource WindowButton}"
                            Tag="{StaticResource IconMinimize}"
                            ToolTip="Minimise"
                            Click="OnMinimiseClick" />
                    <Button x:Name="MaximiseButton"
                            Style="{StaticResource WindowButton}"
                            Tag="{StaticResource IconMaximize}"
                            ToolTip="Maximise"
                            Click="OnMaximiseClick" />
                    <Button Style="{StaticResource WindowCloseButton}"
                            Tag="{StaticResource IconClose}"
                            ToolTip="Close"
                            Click="OnCloseClick" />
                </StackPanel>
            </Grid>

            <ContentControl x:Name="PageHost" Grid.Row="1" />
        </Grid>

        <!--  ================= Lightbox =================
              Over both columns, sidebar included: when a screenshot is up,
              the whole window is what goes dark behind it.  -->
        <ctrl:Lightbox x:Name="Lightbox" Grid.ColumnSpan="2" />
    </Grid>
</Window>
